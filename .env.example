# ── Environment variables for grokkinggenai.com ──
# In Vercel: Project → Settings → Environment Variables. Locally: copy to .env

# Session signing secret. Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# Stripe secret key (Developers → API keys).
# Use sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_…) for the /api/webhook endpoint.
# Created when you add the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Upstash Redis credentials.
# If you add Upstash through the Vercel Marketplace (Storage tab), Vercel injects
# KV_REST_API_URL and KV_REST_API_TOKEN automatically — leave the two below blank.
# Otherwise paste your Upstash REST URL + token here:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. The site URL is auto-detected from the request; set this only to
# force the URL used in Stripe success/cancel redirects.
# SITE_URL=https://grokkinggenai.com
